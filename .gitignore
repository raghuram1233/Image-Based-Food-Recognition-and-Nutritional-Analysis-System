# Training outputs. The committed baseline (Fruits_model.h5) and the small
# per-model *.labels.json sidecars are kept; large models and regenerated
# metrics/curves are not. Commit a trained .keras with `git add -f` (or use
# Git LFS) if you want to ship it.
models/*.keras
models/*.metrics.json
models/*_curves.png
logs/
*.log

# Local artifacts
outputs/
*.tmp
